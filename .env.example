# Domaine public de la régie (sans https://), ex. regie.mondomaine.fr
NODECG_BASE_URL=regie.mondomaine.fr
# Identifiant / mot de passe de la régie (protège la régie ET les overlays).
# Obligatoire en ligne. Le serveur refuse de démarrer tant qu'il vaut « change-moi ».
NODECG_USER=regie
NODECG_PASSWORD=change-moi
# Facultatif : secret qui signe les sessions de connexion (longue chaîne aléatoire).
# Si absent, un secret aléatoire est créé dans db/session-secret (dans le volume persistant) et réutilisé.
# NODECG_SESSION_SECRET=
# Facultatif : jeton de l'API Bitfocus Companion (au moins 16 caractères aléatoires, docs/COMPANION.md).
# Si absent, un jeton est créé dans db/companion-token (dans le volume persistant), visible dans le panneau Données.
# COMPANION_TOKEN=
# Facultatif : jeton de synchronisation avec une régie sur place (au moins 16 caractères aléatoires, docs/DEPLOIEMENT.md).
# Si absent, un jeton est créé dans db/sync-token (dans le volume persistant), visible dans le panneau Données (section 8).
# SYNC_URL=
# SYNC_TOKEN=
# Facultatif : adresse d'écoute. Défaut : 0.0.0.0 avec mot de passe (et toujours dans l'image Docker),
# 127.0.0.1 (ce PC seulement) sans mot de passe.
# NODECG_HOST=0.0.0.0
