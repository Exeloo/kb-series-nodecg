      },
      {
        "file": "transition.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "lower-third.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "ticker.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "replay-bug.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "dual-cam.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "versus.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "veto.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "veto-recap.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "map-intro.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "map-series.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "map-result.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "player-stats.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "player-duel.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "groups.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "bracket.html",
        "width": 1920,
        "height": 1080
      }
    ]
