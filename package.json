{
  "name": "valorant-tournament",
  "version": "0.1.0",
  "private": true,
  "description": "Bundle NodeCG : overlays et régie du tournoi Valorant KB SERIES",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node node_modules/nodecg/index.js",
    "dev": "node --watch-path=extension --watch-path=package.json node_modules/nodecg/index.js",
    "postinstall": "node tools/patch-deps.js",
    "lint": "eslint .",
    "check": "node tools/check.js",
    "verify": "npm run lint && npm run check",
    "shot": "node tools/shot.js",
    "export:stinger": "node tools/export-stinger.js",
    "pack:extension": "node tools/pack-extension.js"
  },
  "nodecg": {
    "compatibleRange": "^2.0.0",
    "assetCategories": [
      {
        "name": "team-logos",
        "title": "Logos équipes",
        "allowedTypes": [
          "png",
          "jpg",
          "jpeg",
          "svg",
          "webp",
          "gif"
        ]
      },
      {
        "name": "sponsors",
        "title": "Logos sponsors",
        "allowedTypes": [
          "png",
          "jpg",
          "jpeg",
          "svg",
          "webp"
        ]
      },
      {
        "name": "player-photos",
        "title": "Photos joueurs (PNG détouré conseillé)",
        "allowedTypes": [
          "png",
          "webp",
          "jpg",
          "jpeg"
        ]
      }
    ],
    "dashboardPanels": [
      {
        "name": "regie",
        "title": "Régie · tout afficher / masquer",
        "file": "regie.html",
        "width": 4,
        "headerColor": "#c9b274"
      },
      {
        "name": "live",
        "title": "Live · score de série",
        "file": "live.html",
        "width": 4,
        "headerColor": "#2b2fb5"
      },
      {
        "name": "lower-thirds",
        "title": "Lower thirds · plateau, presets, intervenants",
        "file": "lower-thirds.html",
        "width": 4,
        "headerColor": "#2b2fb5"
      },
      {
        "name": "ticker",
        "title": "Ticker défilant",
        "file": "ticker.html",
        "width": 4,
        "headerColor": "#2b2fb5"
      },
      {
        "name": "dual-cam",
        "title": "Écran 50/50 (dual-cam)",
        "file": "dual-cam.html",
        "width": 4,
        "headerColor": "#2b2fb5"
      },
      {
        "name": "maps-transitions",
        "title": "Maps & Transitions",
        "file": "maps-transitions.html",
        "width": 4,
        "headerColor": "#2b2fb5"
      },
      {
        "name": "players",
        "title": "Équipes & Joueurs",
        "file": "players.html",
        "width": 8,
        "headerColor": "#2b2fb5",
        "workspace": "1. Match & Joueurs"
      },
      {
        "name": "match",
        "title": "Match (maps, scores, agents)",
        "file": "match.html",
        "width": 6,
        "headerColor": "#2b2fb5",
        "workspace": "1. Match & Joueurs"
      },
      {
        "name": "veto",
        "title": "Veto des maps",
        "file": "veto.html",
        "width": 4,
        "headerColor": "#2b2fb5",
        "workspace": "1. Match & Joueurs"
      },
      {
        "name": "player-stats",
        "title": "Stats Joueur · fiche et duel",
        "file": "player-stats.html",
        "width": 4,
        "headerColor": "#2b2fb5",
        "workspace": "1. Match & Joueurs"
      },
      {
        "name": "planning",
        "title": "Planning de la journée",
        "file": "planning.html",
        "width": 6,
        "headerColor": "#2b2fb5",
        "workspace": "2. Écrans & Tournoi"
      },
      {
        "name": "scenes",
        "title": "Écrans (attente, pause, fin)",
        "file": "scenes.html",
        "width": 4,
        "headerColor": "#2b2fb5",
        "workspace": "2. Écrans & Tournoi"
      },
      {
        "name": "bracket",
        "title": "Bracket & Groupes",
        "file": "bracket.html",
        "width": 6,
        "headerColor": "#2b2fb5",
        "workspace": "2. Écrans & Tournoi"
      },
      {
        "name": "donnees",
        "title": "Données · sauvegarde, import, réglages",
        "file": "donnees.html",
        "width": 4,
        "headerColor": "#2b2fb5",
        "workspace": "3. Données"
      },
      {
        "name": "companion",
        "title": "Companion · boutons et API",
        "file": "companion.html",
        "fullbleed": true,
        "headerColor": "#2b2fb5"
      }
    ],
    "graphics": [
      {
        "file": "stream.html",
        "width": 1920,
        "height": 1080
